APP_NAME=Ontime
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://ontime.oceanspace.co.id, SESSION_SECURE_COOKIE=true,
# APP_LOCALE=id, and TRUSTED_PROXIES=* (or the proxy IPs) when a proxy or load balancer ends TLS.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue on Redis, processed by Horizon (php artisan horizon), as in dnd-web, gais-web and helpdesk-web.
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360
REDIS_QUEUE_BLOCK_FOR=5

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Observability — Horizon di /horizon; QUEUE_CONNECTION=redis
HORIZON_PATH=horizon
LOG_VIEWER_ENABLED=true
LOG_VIEWER_PATH=log-viewer

# WhatsApp — WagHub Gateway (same keys as gais-web, dnd-web, helpdesk-web).
# Used for the WhatsApp OTP login and account info messages. Fill WAG_TOKEN to turn it on.
WAG_URL=https://waghub.mekayastudio.com
WAG_TOKEN=

# Email login (code + magic link) appears once MAIL_MAILER sends real mail (e.g. smtp, not log).
EMAIL_LOGIN_EXPIRES_IN=600
# Where the email login link opens the mobile app. Expo Go needs e.g. exp://127.0.0.1:8081/--/
MOBILE_APP_DEEP_LINK=ontime://
MOBILE_APP_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=co.id.oceanspace.ontime
MOBILE_APP_APP_STORE_URL=
# API tokens (mobile sessions) stop working after this many minutes without use; default 90 days, 0 = never.
SANCTUM_IDLE_EXPIRATION=129600
# Core HR webhook (employee sync). Requests are rejected while this is empty.
CORE_WEBHOOK_SECRET=

# Core SSO (optional). When set, the login page shows an "Akun Core (SSO)" button.
CORE_CLIENT_ID=
CORE_CLIENT_SECRET=
CORE_REDIRECT_URI=

# Verifikasi wajah presensi. FACE_DRIVER=basic hanya membandingkan warna piksel (bukan pengenalan wajah sungguhan).
# FACE_DRIVER=compreface memakai CompreFace yang di-host sendiri (layanan Docker terpisah) dan wajib untuk liveness.
FACE_DRIVER=basic
# Alamat CompreFace dan API key layanan "Verification" serta "Detection" dari dashboard CompreFace.
COMPREFACE_URL=
COMPREFACE_VERIFICATION_KEY=
COMPREFACE_DETECTION_KEY=
COMPREFACE_TIMEOUT=15
COMPREFACE_DET_PROB_THRESHOLD=0.8
# Masa berlaku tantangan liveness (gerak kepala) dalam detik.
LIVENESS_TTL_SECONDS=180

# Push notifikasi aplikasi lewat OneSignal. App ID publik; REST API key rahasia (Dashboard > Settings > Keys & IDs).
ONESIGNAL_APP_ID=37e96a62-f9fc-45d5-8159-1f079b3f80f5
# Kosongkan untuk memakai App ID yang sama di panel web. Web push hanya jalan di HTTPS (atau localhost)
# dan Site URL di dashboard OneSignal harus sama persis dengan alamat panel.
ONESIGNAL_WEB_APP_ID=
ONESIGNAL_REST_API_KEY=
