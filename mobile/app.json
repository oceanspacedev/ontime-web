{
  "expo": {
    "name": "OnTime",
    "slug": "ontime-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ontime",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F22929"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.id.oceanspace.ontime",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.id.oceanspace.ontime",
      "adaptiveIcon": {
        "backgroundColor": "#F22929",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "OnTime memakai kamera untuk foto selfie presensi dan foto master wajah.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OnTime memakai lokasi untuk memastikan presensi dilakukan di area kantor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OnTime membuka galeri untuk memilih foto master wajah dan lampiran pengajuan.",
          "cameraPermission": "OnTime memakai kamera untuk foto master wajah."
        }
      ],
      "expo-document-picker",
      "expo-font",
      "./plugins/withOptionalHardwareFeatures",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "project": "ontime-mobile",
          "organization": "developer-hof"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "oneSignalAppId": "37e96a62-f9fc-45d5-8159-1f079b3f80f5",
      "sentryDsn": "https://b8de05c4e574a1531c9ef59c54fcfa8e@o4510944541016064.ingest.de.sentry.io/4512383893110864",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "co.id.oceanspace.ontime.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.co.id.oceanspace.ontime.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3a6ac943-6076-4734-96e7-2dc83cd5605c"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "apriansyahrs"
  }
}
