# API host this build talks to, inlined by Expo when the bundle is made (src/lib/session.ts).
# Local development: the Laravel server on this machine. Android emulator: http://10.0.2.2:8000/api/v1.
# Plain http is accepted only for local hosts (localhost, 127.x, 10.x, 192.168.x, 172.16-31.x, *.local, *.test).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# The production profile in eas.json sets EXPO_PUBLIC_APP_ENV=production and the production host.
# Any other build without EXPO_PUBLIC_API_URL refuses to connect and says so on the login screen,
# so a preview build never writes to production by accident. Give the preview profile its staging
# host as an EAS environment variable (eas env:create --environment preview) or in eas.json.
# EXPO_PUBLIC_APP_ENV=development
